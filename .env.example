# Shadow AI API configuration. Copy to .env and fill at least one key.
# Auto priority: Groq > OpenRouter > OpenAI > Perplexity > NVIDIA > Gemini.
SHADOW_AI_PROVIDER=auto
# true hides the Electron/npm terminal; false opens a visible terminal.
SHADOW_AI_SILENT=true

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
NVIDIA_API_KEY=
