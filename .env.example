# Shadow AI API configuration. Copy to .env and fill at least one key.
# Auto priority: Groq > OpenRouter > OpenAI > Perplexity > NVIDIA > Gemini.
SHADOW_AI_PROVIDER=auto
# true hides the Electron/npm terminal; false opens a visible terminal.
SHADOW_AI_SILENT=true

# Debug logging for raw chunk dots, timing measurements, and transcription
# content. Set to 1 to enable verbose debug output.
# SHADOW_AI_DEBUG=1

# Override the config directory path (used by tests to isolate storage).
# SHADOW_AI_CONFIG_DIR=

# Gemini Live model to use for real-time voice sessions.
# If unset, defaults to: gemini-2.5-flash-native-audio-preview-09-2025
# GEMINI_LIVE_MODEL=

GEMINI_API_KEY=
GROQ_API_KEY=
# Optional additional accounts are tried in numeric order; gaps are allowed.
# GROQ_API_KEY_1=
# GROQ_API_KEY_3=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
NVIDIA_API_KEY=

# Streaming speech-to-text for BYOK voice sessions (Nova-3).
DEEPGRAM_API_KEY=
NEMO_SPEECH_URL=http://127.0.0.1:8080
NEMO_SPEECH_API_KEY=
