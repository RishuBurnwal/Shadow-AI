{
    "name": "shadow-ai",
    "productName": "Shadow AI",
    "version": "0.7.0",
    "description": "Shadow AI real-time desktop assistant",
    "main": "src/index.js",
    "scripts": {
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage",
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "build:assets": "esbuild node_modules/lit/index.js --bundle --format=esm --outfile=src/assets/lit-core-2.7.4.min.js --minify && esbuild node_modules/highlight.js/lib/index.js --bundle --format=iife --global-name=hljs --outfile=src/assets/highlight-11.9.0.min.js --minify && cp node_modules/marked/lib/marked.umd.js src/assets/marked-4.3.0.min.js && cp node_modules/highlight.js/styles/vs2015.min.css src/assets/highlight-vscode-dark.min.css",
        "lint": "prettier --check .",
        "lint:fix": "prettier --write .",
        "test:e2e": "npx playwright test",
        "test:audio-devices": "node scripts/audio-device-smoke.js"
    },
    "keywords": [
        "shadow ai",
        "shadow ai assistant",
        "shadow ai desktop assistant",
        "shadow ai assistant for interviews"
    ],
    "author": {
        "name": "sohzm",
        "email": "sohambharambe9@gmail.com"
    },
    "license": "GPL-3.0",
    "dependencies": {
        "@google/genai": "^2.12.0",
        "@huggingface/transformers": "^3.8.1",
        "electron-squirrel-startup": "^1.0.1",
        "ollama": "^0.6.3",
        "onnxruntime-node": "^1.21.0",
        "unpdf": "^1.6.2",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.8.1",
        "@electron-forge/maker-dmg": "^7.8.1",
        "@electron-forge/maker-squirrel": "^7.8.1",
        "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
        "@electron-forge/plugin-fuses": "^7.8.1",
        "@electron/fuses": "^1.8.0",
        "@playwright/test": "^1.61.1",
        "@reforged/maker-appimage": "^5.0.0",
        "electron": "^40.10.2",
        "highlight.js": "^11.9.0",
        "lit": "^2.7.4",
        "marked": "^4.3.0",
        "prettier": "^3.9.5"
    }
}
